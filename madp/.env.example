# Internal workflow service; frontend clients must use the authenticated .NET gateway.
MF_BLOCKS_SHELL_ENABLED=1
MF_APP_ORIGIN=http://127.0.0.1:5311
MF_LISTEN_HOST=127.0.0.1
# Optional expected Host when a private container/service DNS name is used by the gateway.
MF_INTERNAL_HOST=
PORT=5311
FACTORY_PLATFORM=blocks
VITE_BLOCKS_AUTH_MODE=embedded
VITE_BLOCKS_API_URL=
MF_BLOCKS_TENANT=
MF_SVC_CLIENT_ID=
MF_SVC_CLIENT_SECRET=

# Same random server-only value as .NET Madp__BridgeKey; at least 32 bytes.
MF_BLOCKS_SHELL_KEY=
# Exact validated permission strings allowed to write MADP workflows in this deployment.
MF_BLOCKS_SHELL_WRITE_PERMISSIONS=blocks-monitor::monitor::write

# Repository worker callback; configure only on approved engine hosts.
MF_BLOCKS_REPOSITORY_URL=
MF_BLOCKS_REPOSITORY_KEY=
