{
  "name": "blocks-madp-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MADP project workflow embedded in the Blocks project shell",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:server": "tsc --noEmit -p tsconfig.server.json && vite build --config vite.server.config.ts",
    "start": "node --experimental-sqlite dist-server/production.mjs",
    "dev:server": "node --experimental-sqlite --env-file-if-exists=.env.local scripts/serve-shell.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "engine:blocks": "node server/blocks/engineWorker/start.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@seliseblocks/client": "0.2.0",
    "@tanstack/react-query": "5.101.4",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "pdf-parse": "2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "three": "0.172.0",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.172.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
