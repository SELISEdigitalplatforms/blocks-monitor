# Copy this file to `.env.e2e` (gitignored) and fill in real values.
#
# Switch environments by changing E2E_BASE_URL only — OS is derived automatically:
#   Dev:  https://dev-monitor.blocksdevelopers.com  → OS https://dev-os.blocksdevelopers.com
#   Prod: https://monitor.seliseblocks.com          → OS https://os.seliseblocks.com
# Override OS anytime with E2E_OS_BASE_URL.

# ── Dev (blocksdevelopers.com) ──────────────────────────────────────────────
E2E_BASE_URL=https://dev-monitor.blocksdevelopers.com
# E2E_OS_BASE_URL=https://dev-os.blocksdevelopers.com

# ── Prod (seliseblocks.com) — uncomment these and comment Dev above ──────────
# E2E_BASE_URL=https://monitor.seliseblocks.com
# E2E_OS_BASE_URL=https://os.seliseblocks.com

# Local build via named domain + hosts entry (port 5001, see run.sh):
#   127.0.0.1 dev-monitor.blocksdevelopers.com
#   E2E_BASE_URL=https://dev-monitor.blocksdevelopers.com:5001

# Test account credentials
E2E_USERNAME=
E2E_PASSWORD=

# Optional project name prefix (create uses `${PROJECT_NAME} ${Date.now()}`)
# PROJECT_NAME=PROD-TEST

# Reuse an existing project instead of creating one each run.
# E2E_REUSE_PROJECT_NAME=test

# Open a project by UUID (/app/{id}/dashboard) — skips console card search.
# E2E_PROJECT_ID=

# Keep the shared project after the run (also kept automatically on failure).
# E2E_KEEP_PROJECT=1

# Set to 1 to skip auto-starting the app (you manage the server, or remote host).
# Required when E2E_BASE_URL points at the remote host — otherwise Playwright
# runs `run.sh -b` to boot a local API you don't want.
E2E_NO_WEBSERVER=1

# Pause after each test (default 10000 headed / 0 headless).
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action.
# E2E_SLOWMO=600
