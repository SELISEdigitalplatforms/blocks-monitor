<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageVersion Include="MailKit" Version="4.16.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="MongoDB.Driver" Version="3.8.0" />
    <!--
      Genesis is declared at 4.0.8 and every project now resolves that one version. This previously
      sat at 4.0.2 with Api's graph lifted to 4.0.5 by ReleaseDriver.OS 4.0.1, so Api and Worker ran
      different Genesis versions on purpose; that split is gone. Worker was deliberately left on the
      older version at the time because issue #201 did not touch it and its behaviour had not been
      assessed against 4.0.5 - it is now on 4.0.8 along with everything else, so Worker is the part
      to watch if something regresses.

      4.0.8 adds delegated access, which registers a startup validator that fails the host unless
      BLOCKS_IAM_BASE_URL or BLOCKS_IAM_TOKEN_ENDPOINT resolves. Both processes get it from the
      Secrets KeyPairs document via SeliseBlocks.ConfigurationDriver (key
      'FrontendRuntime:BLOCKS_IAM_BASE_URL', provisioned by blocks-infra/configure.sh), so no
      environment variable is needed - but an environment provisioned before that infra change must
      be re-provisioned or the host will not start.
    -->
    <PackageVersion Include="SeliseBlocks.Genesis.OS" Version="4.0.8" />
    <PackageVersion Include="SeliseBlocks.ReleaseDriver.OS" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="8.8.0" />
    <PackageVersion Include="JUnitLogger" Version="1.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="SeliseBlocks.ConfigurationDriver" Version="10.0.0-preview.1" />
  </ItemGroup>
</Project>
