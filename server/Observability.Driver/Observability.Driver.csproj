<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>10.0.0-preview.4</Version>
    <PackageId>SeliseBlocks.ObservabilityDriver</PackageId>
    <Authors>SeliseBlocks</Authors>
    <Company>SeliseBlocks</Company>
    <Description>Blocks Monitor Driver - Monitor and Health APIs</Description>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IncludeOutputAssemblies>true</IncludeOutputAssemblies>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Genesis, BlocksGenesis, SeliseBlocksGenesis, Observability, Monitor, Health, Driver</PackageTags>
    <RepositoryUrl>https://github.com/SELISEdigitalplatforms/blocks-monitor</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transitive dependencies of Alert.DomainService bundled in this package -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="SeliseBlocks.Genesis" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against Alert.DomainService but bundle its DLL into the package
         (PrivateAssets="all") rather than emitting it as a package dependency,
         since Alert.DomainService is not itself published to NuGet. -->
    <ProjectReference Include="..\Alert.DomainService\Alert.DomainService.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(OutputPath)Alert.DomainService.dll" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>

</Project>
