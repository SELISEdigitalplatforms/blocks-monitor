{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "SwaggerOptions": {
    "Version": "v1",
    "Title": "Blocks Monitor",
    "Description": "Blocks Monitor API documentation",
    "XmlCommentsFilePath": "Api.xml",
    "EndpointUrl": "v1/swagger.json",
    "EnableBearerAuth": true,
    "ServiceName": "blocks-monitor-api"
  },

  // CSP hosts come from FrontendRuntime, so they follow the environment automatically.
  // These are only the fixed third-party hosts the old policy allowed. Space- or
  // comma-separated; override per environment via Csp__ExtraConnectSrc / Csp__ExtraImgSrc.
  "Csp": {
    "ExtraConnectSrc": "https://api.rollbar.com https://code.selise.biz https://www.google.com https://www.gstatic.com https://blocksdev.blob.core.windows.net",
    "ExtraImgSrc": "https://az-cdn.selise.biz https://blocksdev.blob.core.windows.net"
  }
}
