# MADP Factory web app — copy to .env.local and fill in. Names and meanings only; ask the project owner for the values.
# See docs/RUN-WITH-OWNER-ENGINE.md. Never commit .env.local.
#
# The web app (this Vite server, on any machine) never runs Claude, the MADP engine, builds or git work. Everything
# people do creates rows and EngineJob rows in Blocks; the owner's MADP engine (on the owner's machine) picks them up.

# ── Web app on any machine (developer PC or deployment) ─────────────────────────────────────────────────────────────
# "blocks" = the real Blocks tenant (the normal mode). "local" = the old single-machine SQLite store with its own
# in-process engine (tests and offline work only).
FACTORY_PLATFORM=
# Sign-in in the app's own pages ("embedded"); public browser settings, no secrets.
VITE_BLOCKS_AUTH_MODE=
VITE_BLOCKS_API_URL=
# The Factory tenant's project key (the same value as MF_BLOCKS_TENANT).
VITE_BLOCKS_PROJECT_KEY=
VITE_BLOCKS_OIDC_CLIENT_ID=
VITE_BLOCKS_OIDC_URL=
VITE_BLOCKS_OIDC_SCOPE=
# The HTTPS host name and port this server answers on (the host name must resolve to 127.0.0.1 on your machine).
VITE_BLOCKS_DEV_HOST=
VITE_BLOCKS_DEV_PORT=
# Public sign-up: the terms of service and privacy policy the sign-up form links to (public URLs, not secrets).
# Left empty, the form names both documents without a link.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Server-only (never VITE_): the Factory tenant and the service identity the server's functions use for the Data
# Gateway and Storage. Secret — the owner shares them privately.
MF_BLOCKS_TENANT=
MF_SVC_CLIENT_ID=
MF_SVC_CLIENT_SECRET=
# Where Blocks Utilities (plans, discounts, subscriptions, payments) is called when PlatformSetting billing.source is
# "blocks-utilities": a path on the Blocks API (default /utilities/v4) or the Utilities host's API root
# (https://utilities.<domain>/api). Optional.
MF_BLOCKS_UTILITIES_BASE=

# GitHub sign-in for repositories (optional on a developer machine). The callback URL is
# https://<VITE_BLOCKS_DEV_HOST>:<VITE_BLOCKS_DEV_PORT>/api/github/callback. The key is a 32-byte hex secret
# (node scripts/generate-github-key.mjs); it must be the same on every server of the tenant.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MF_GITHUB_TOKEN_KEY=

# ── Engine host only (the owner's machine; leave empty or unset everywhere else) ────────────────────────────────────
# Blocks projects for new Factory projects are made with the Blocks CLI by the engine worker. "true" only on the engine
# host, after the provisioning fields are applied; a web server never runs the Blocks CLI.
MF_BLOCKS_PROVISIONING_ENABLED=
MF_BLOCKS_PROVISIONING_ACCOUNT=
# Where the engine keeps one folder per project (repo, inputs, knowledge base, builds, job logs).
MF_ENGINE_ROOT=
# Shared engine runner selection, also used by the planner's Figma job (legacy default: claude).
AI_RUNNER=claude
# Optional native executable override for that selected runner.
AI_RUNNER_BINARY=
# Set this to "codex" or "claude" to use those CLIs instead; antigravity
# (Google's `agy` CLI) must be installed and signed in once interactively.
# The engine's writer jobs (requirements, milestones, etc.) and the factory
# design prototype writer will use this runner's headless mode.
# Binary location: set MF_ENGINE_AI_ANTIGRAVITY_BINARY, MF_EXTRACTION_ANTIGRAVITY_BINARY,
# or ensure agy.exe is on PATH; the "agy" binary is auto-resolved when installed.
# "claude" = real builds with Claude Code; anything else = no real builds.
MF_ENGINE_BUILD=
# The Claude Code executable the engine runs (absolute path; it uses the engine user's own sign-in).
MADP_CLAUDE_BIN=
# Jobs created before this ISO time are left alone (keep it fixed; do not move it to the start time).
ENGINE_SINCE=
# Folder for engine.json (pause / pace) and the worker's pid file.
ENGINE_HOST_DIR=
# Optional operator scope. Unset means the full worker; invalid ids/kinds stop startup.
MF_ENGINE_PROJECT_IDS=
MF_ENGINE_JOB_KINDS=
# 1 = read-only/paused: never claim jobs, enforce timeouts or provision tenants.
MF_ENGINE_READ_ONLY=
# File extraction stays on the cloud engine's Claude runner, independent of the planner's AI_RUNNER.
# Override deliberately with "codex" only when its file/image adapter is configured on the engine host.
MF_EXTRACTION_RUNNER=claude
MF_EXTRACTION_CLAUDE_BINARY=
MF_EXTRACTION_CODEX_BINARY=
MF_EXTRACTION_ANTIGRAVITY_BINARY=
MF_EXTRACTION_MODEL=

# Figma Make (owner engine only). Never set these on the web server or expose them as VITE_ values.
# Dedicated headless runner for Figma design jobs only (empty = AI_RUNNER, normally claude). Codex or Antigravity
# are backups. It never changes the runner of the other engine jobs or of file extraction.
MF_ENGINE_FIGMA_RUNNER=
# Optional native binary override, only for this Figma runner.
MF_ENGINE_FIGMA_BINARY=
# Optional design-model override; global MADP_AGENT_MODEL wins. Unset uses the selected runner default.
MF_ENGINE_FIGMA_MODEL=
MF_ENGINE_FIGMA_ENABLED=
# Use the currently available headless import workflow. "agent" requires Make prompting/progress tools in the MCP catalog.
MF_ENGINE_FIGMA_WORKFLOW=import
# Operator approval for private initial imports; no paid prompts or automatic publishing. Unset blocks imports.
MF_ENGINE_FIGMA_IMPORT_APPROVED=
# Operator-only approval for paid Make iterations within the limits below; never a browser/user checkbox.
# Set to 1 only after the engine owner approves Figma billing. Unset blocks new remote writes.
MF_ENGINE_FIGMA_CREDITS_APPROVED=
# Absolute path to the server-side MCP config. Use config/figma-mcp.local.json for credentials (gitignored).
MF_ENGINE_FIGMA_MCP_CONFIG=
# Optional credential referenced by config/figma-mcp-token.example.json; never expose as VITE_ or commit a real token.
FIGMA_OAUTH_TOKEN=
# Optional overrides. Unset: current engine CLI identity and <MF_ENGINE_ROOT or ENGINE_HOST_DIR or data>/figma-state.
MF_ENGINE_FIGMA_AUTH_DIR=
MF_ENGINE_FIGMA_STATE_DIR=
# Caps iterations, not provider credits. Actual Figma credit costs are controlled by Figma.
MF_ENGINE_FIGMA_MAX_ITERATIONS_PER_DAY=5
# Claude-only estimated USD/turn caps. Codex uses account-side model billing controls plus the daily iteration cap.
MF_ENGINE_FIGMA_MAX_BUDGET_USD=5
MF_ENGINE_FIGMA_MAX_TURNS=80
# Operator-owned routing for headless Factory-managed design jobs (no Figma browser session).
# Set to the stable id of the worker running engine:local -- <projectId> --factory --activate.
MF_FACTORY_DESIGN_WORKER_ID=
# Native Figma Design worker route. Use a stable distinct id, e.g. madp-figma-production.
# Set the same value as MF_ENGINE_WORKER_ID on the Figma worker.
MF_FIGMA_DESIGN_WORKER_ID=
# Keep the existing extractor's identity here when splitting workers. Never use the Figma-only id.
MF_EXTRACTION_WORKER_ID=
# Local general workers can exclude kinds owned by a remote worker. Keeps provisioning enabled.
MF_ENGINE_EXCLUDED_JOB_KINDS=
# Figma worker only: exact workspace name selected by the operator; prevents interactive destination prompts.
MF_ENGINE_FIGMA_WORKSPACE=
# Optional persistent host/state and project root paths on the cloud worker.
# ENGINE_HOST_DIR=/var/lib/madp-figma/host
# MF_ENGINE_ROOT=/var/lib/madp-figma/engine-root
# MF_ENGINE_WORKER_ID=madp-figma-production
# Per-project daily design revision cap. Existing jobs reuse their reservation on recovery.
MF_ENGINE_FACTORY_MAX_ITERATIONS_PER_DAY=5
