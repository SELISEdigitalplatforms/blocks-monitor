{
  "name": "madp-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MADP Factory: Blocks-backed software factory frontend with an optional local development adapter",
  "scripts": {
    "cert": "node scripts/generate-cert.mjs",
    "check:blocks-auth": "node scripts/check-blocks-auth.mjs",
    "check:auth-ui": "node scripts/check-auth-ui.mjs",
    "check:wizard-schema": "node scripts/check-wizard-schema.mjs",
    "check:extraction-runner": "node scripts/check-extraction-runner.mjs",
    "figma:check": "node scripts/check-figma.mjs",
    "check:figma-ui": "node scripts/check-figma-ui.mjs",
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite",
    "build": "tsc --noEmit -p . && cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "i18n:push": "node scripts/uilm-push.mjs",
    "test": "vitest run",
    "reset": "node --experimental-sqlite server/local/reset.mjs",
    "mailbox": "node --experimental-sqlite server/local/mailbox.mjs",
    "engine:blocks": "node server/blocks/engineWorker/start.mjs",
    "engine:figma": "node server/blocks/engineWorker/screens.mjs",
    "engine:local": "node server/blocks/engineWorker/local.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e-report/html",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node --experimental-sqlite dist-server/production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@seliseblocks/client": "0.2.0",
    "@tanstack/react-query": "5.101.4",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "modern-screenshot": "^4.7.0",
    "pdf-parse": "2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "three": "0.172.0",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.172.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "cross-env": "7.0.3",
    "postcss": "8.5.28",
    "selfsigned": "2.4.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
