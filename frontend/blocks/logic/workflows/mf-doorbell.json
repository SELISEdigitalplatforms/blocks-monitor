      "parameters": {
        "mode": "each",
        "language": "js",
        "script": "var TEMPLATES = {\n  \"job.failed\": { purpose: \"mf-build-failed\", subject: [\"projectName\"], body: [\"projectName\", \"jobKind\", \"failure\", \"failedAt\", \"link\"] },\n  \"invited\": { purpose: \"mf-workspace-added\", subject: [\"workspaceName\"], body: [\"actorName\", \"workspaceName\", \"roleName\", \"link\"] },\n  \"access-requested\": { purpose: \"mf-access-requested\", subject: [\"email\"], body: [\"actorName\", \"email\", \"workspaceName\", \"link\"] }\n};\nvar APP_URL = \"__APP_URL__\";\nvar row = $json || {};\nvar recipient = \"\";\nif (typeof row.RecipientUserId === \"string\" && /^[A-Za-z0-9-]{1,64}$/.test(row.RecipientUserId)) {\n  recipient = row.RecipientUserId;\n}\nvar params = {};\ntry {\n  var parsed = JSON.parse(row.ParamsJson);\n  if (parsed !== null && typeof parsed === \"object\" && !Array.isArray(parsed)) {\n    params = parsed;\n  }\n} catch (e) {\n  params = {};\n}\nfunction clean(value, cap) {\n  var text = \"\";\n  if (typeof value === \"string\") {\n    text = value;\n  } else if (typeof value === \"number\" && isFinite(value)) {\n    text = String(value);\n  }\n  return text.replace(/[\\u0000-\\u001f\\u007f-\\u009f]/g, \"\").slice(0, cap);\n}\nfunction validEmail(value) {\n  if (typeof value !== \"string\") { return \"\"; }\n  var address = value.trim().toLowerCase();\n  if (address.length === 0 || address.length > 254) { return \"\"; }\n  if (/[\\s\\u0000-\\u001f\\u007f-\\u009f]/.test(address)) { return \"\"; }\n  var at = address.indexOf(\"@\");\n  if (at < 1 || at !== address.lastIndexOf(\"@\")) { return \"\"; }\n  if (address.indexOf(\".\", at) === -1) { return \"\"; }\n  if (address.length === at + 1) { return \"\"; }\n  return address;\n}\nfunction safePath(value) {\n  if (typeof value !== \"string\") { return false; }\n  if (value.length === 0 || value.length > 300) { return false; }\n  if (value.charAt(0) !== \"/\" || value.charAt(1) === \"/\") { return false; }\n  if (/[\\\\\\s\\u0000-\\u001f\\u007f-\\u009f]/.test(value)) { return false; }\n  return true;\n}\nvar kind = typeof row.Kind === \"string\" ? row.Kind : \"\";\nvar template = Object.prototype.hasOwnProperty.call(TEMPLATES, kind) ? TEMPLATES[kind] : null;\nvar to = validEmail(params.emailTo);\nvar email = recipient !== \"\" && row.EmailStatus === \"pending\" && template !== null &&\n  params.emailTemplate === (template ? template.purpose : \"\") && to !== \"\";\nvar subject = {};\nvar body = {};\nif (email) {\n  var i;\n  for (i = 0; i < template.subject.length; i++) {\n    subject[template.subject[i]] = clean(params[template.subject[i]], 120);\n  }\n  for (i = 0; i < template.body.length; i++) {\n    var key = template.body[i];\n    if (key === \"link\") {\n      body.link = APP_URL + (safePath(row.Link) ? row.Link : \"/home\");\n    } else {\n      body[key] = clean(params[key], 200);\n    }\n  }\n}\nreturn {\n  recipient: recipient,\n  ring: recipient !== \"\",\n  email: email,\n  to: email ? to : \"\",\n  template: email ? template.purpose : \"\",\n  subject: subject,\n  body: body\n};\n"
      },
